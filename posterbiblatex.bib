	doi = {10.1088/1475-7516/2011/07/034},
	shorttitle = {The Cosmic Linear Anisotropy Solving System ({CLASS}). Part {II}},
	abstract = {Boltzmann codes are used extensively by several groups for constraining cosmological parameters with Cosmic Microwave Background and Large Scale Structure data. This activity is computationally expensive, since a typical project requires from 104 to 105 Boltzmann code executions. The newly released code {CLASS} (Cosmic Linear Anisotropy Solving System) incorporates improved approximation schemes leading to a simultaneous gain in speed and precision. We describe here the three approximations used by {CLASS} for basic Λ{CDM} models, namely: a baryon-photon tight-coupling approximation which can be set to ﬁrst order, second order or to a compromise between the two; an ultra-relativistic ﬂuid approximation which had not been implemented in public distributions before; and ﬁnally a radiation streaming approximation taking reionisation into account.},
	pages = {034--034},
	number = {7},
	journaltitle = {Journal of Cosmology and Astroparticle Physics},
	shortjournal = {J. Cosmol. Astropart. Phys.},
	author = {{Diego Blas} and {Julien Lesgourgues} and {Thomas Tram}},
	urldate = {2024-08-27},
	date = {2011-07-01},
	langid = {english},
	file = {PDF:/Users/vpedreros/Zotero/storage/GPJ6JQXB/Diego Blas et al. - 2011 - The Cosmic Linear Anisotropy Solving System (CLASS). Part II Approximation schemes.pdf:application/pdf},
}

