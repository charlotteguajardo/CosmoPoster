	file = {PDF:/Users/vpedreros/Zotero/storage/9DM3K36B/Bose et al. - 2024 - Matter Power Spectra in Modified Gravity A Comparative Study of Approximations and \$N\$-Body Simulat.pdf:application/pdf},
}

@article{zucca_mgcamb_2019,
	title = {{MGCAMB} with massive neutrinos and dynamical dark energy},
	volume = {2019},
	issn = {1475-7516},
	url = {http://arxiv.org/abs/1901.05956},
	doi = {10.1088/1475-7516/2019/05/001},
	abstract = {We present a major upgrade of {MGCAMB}, a patch for the Einstein-Boltzmann solver {CAMB} used for phenomenological tests of general relativity against cosmological datasets. This new version is compatible with the latest {CosmoMC} code and includes a consistent implementation of massive neutrinos and dynamical dark energy. The code has been restructured to make it easier to modify to fit the custom needs of specific users. To illustrate the capabilities of the code, we present joint constraints on the modified growth, massive neutrinos and the dark energy equation of state from the latest cosmological observations, including the recent galaxy counts and weak lensing measurements from the Dark Energy Survey, and find a good consistency with the \{{\textbackslash}Lambda\}{CDM} model.},
