@misc{arjona_effective_2020,
	title = {The effective fluid approach for modified gravity},
	url = {http://arxiv.org/abs/2010.04764},
	abstract = {Current and coming surveys will require sub-percent agreement in theoretical accuracy to test the different cosmological and gravity scenarios. This can be performed with Boltzmann solvers, i.e. codes that solve the linear evolution of cosmological perturbations. Given the plethora of gravity models, it is crucial to have a standardized unified way to describe all of them and take them into account in a Boltzmann code. Dark Energy ({DE}) and Modified Gravity ({MG}) models, although at a first glance quite dissimilar, are possible to unify them within the same framework. In this paper we present a scenario, based on the effective fluid approach that allows to map any modified gravity model as an effective dark energy fluid and then we show how to implement it into existing Boltzmann codes in a simple and straightforward way. This approach has also the advantage that only a handful of variables are needed to compute, i.e the equation of state \$w(a)\$ at the background level and the sound speed \$c\_s{\textasciicircum}2(a,k)\$ and the anisotropic stress \${\textbackslash}pi(a,k)\$ at the linear perturbation. In particular we show that with simple modifications to the latter Cosmic Linear Anisotropy Solving System ({CLASS}) code, which we called {EFCLASS}, we provide competitive results in a much simpler and less error-prone approach in including the effects of modified gravity models. To test our modifications, we particularize the effective fluid approach to f(R) theories and a surviving class of Horndeski models, the designer Horndeski ({HDES}) which have a background exactly to the standard cosmological model \${\textbackslash}Lambda\${CDM}.},
	number = {{arXiv}:2010.04764},
	publisher = {{arXiv}},
	author = {Arjona, Rubén},
	urldate = {2024-09-06},
	date = {2020-10-09},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {2010.04764 [astro-ph, physics:gr-qc]},
	keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics, General Relativity and Quantum Cosmology},
	file = {PDF:/Users/vpedreros/Zotero/storage/D4G529RN/Arjona - 2020 - The effective fluid approach for modified gravity.pdf:application/pdf},
}

@article{arjona_designing_2019,
	title = {Designing Horndeski and the effective fluid approach},
	volume = {100},
	issn = {2470-0010, 2470-0029},
	url = {http://arxiv.org/abs/1904.06294},
	doi = {10.1103/PhysRevD.100.063526},
	abstract = {We present a family of designer Horndeski models, i.e. models that have a background exactly equal to that of the \${\textbackslash}Lambda\${CDM} model but perturbations given by the Horndeski theory. Then, we extend the effective fluid approach to Horndeski theories, providing simple analytic formulae for the equivalent dark energy effective fluid pressure, density and velocity. We implement the dark energy effective fluid formulae in our code {EFCLASS}, a modified version of the widely used Boltzmann solver {CLASS}, and compare the solution of the perturbation equations with those of the code hi\_CLASS which already includes Horndeski models. We find that our simple modifications to the vanilla code are accurate to the level of \${\textbackslash}sim 0.1{\textbackslash}\%\$ with respect to the more complicated hi\_CLASS code. Furthermore, we study the kinetic braiding model both on and off the attractor and we find that even though the full case has a proper \${\textbackslash}Lambda\${CDM} model limit for large \$n\$, it is not appropriately smooth, thus causing the quasistatic approximation to break down. Finally, we focus on our designer model ({HDES}), which has both a smooth \${\textbackslash}Lambda\${CDM} limit and well-behaved perturbations, and we use it to perform Markov Chain Monte Carlo analyses to constrain its parameters with the latest cosmological data. We find that our {HDES} model can also alleviate the soft \$2{\textbackslash}sigma\$ tension between the growth data and Planck 18 due to a degeneracy between \${\textbackslash}sigma\_8\$ and one of its model parameters that indicates the deviation from the \${\textbackslash}Lambda\${CDM} model.},
	pages = {063526},
	number = {6},
	journaltitle = {Physical Review D},
	shortjournal = {Phys. Rev. D},
	author = {Arjona, Rubén and Cardona, Wilmar and Nesseris, Savvas},
	urldate = {2024-09-23},
	date = {2019-09-20},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {1904.06294 [astro-ph, physics:gr-qc]},
	keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics, General Relativity and Quantum Cosmology},
	file = {PDF:/Users/vpedreros/Zotero/storage/D2CJFCLF/Arjona et al. - 2019 - Designing Horndeski and the effective fluid approach.pdf:application/pdf},
}

@article{carrasco_effective_2012,
	title = {The effective field theory of cosmological large scale structures},
	volume = {2012},
	issn = {1029-8479},
	url = {https://doi.org/10.1007/JHEP09(2012)082},
	doi = {10.1007/JHEP09(2012)082},
	abstract = {Large scale structure surveys will likely become the next leading cosmological probe. In our universe, matter perturbations are large on short distances and small at long scales, i.e. strongly coupled in the {UV} and weakly coupled in the {IR}. To make precise analytical predictions on large scales, we develop an effective field theory formulated in terms of an {IR} effective fluid characterized by several parameters, such as speed of sound and viscosity. These parameters, determined by the {UV} physics described by the Boltzmann equation, are measured from N-body simulations. We find that the speed of sound of the effective fluid is \$ c\_s{\textasciicircum}2 {\textbackslash}approx \{1\}\{0{\textasciicircum}\{\{ - \{6\}\}\}\}\{c{\textasciicircum}\{2\}\} \$and that the viscosity contributions are of the same order. The fluid describes all the relevant physics at long scales k and permits a manifestly convergent perturbative expansion in the size of the matter perturbations δ(k) for all the observables. As an example, we calculate the correction to the power spectrum at order δ(k)4. The predictions of the effective field theory are found to be in much better agreement with observation than standard cosmological perturbation theory, already reaching percent precision at this order up to a relatively short scale k ⋍ 0.24h Mpc−1.},
	pages = {82},
	number = {9},
	journaltitle = {Journal of High Energy Physics},
	shortjournal = {J. High Energ. Phys.},
	author = {Carrasco, John Joseph M. and Hertzberg, Mark P. and Senatore, Leonardo},
	urldate = {2024-09-30},
	date = {2012-09-20},
	langid = {english},
	keywords = {Cosmology of Theories beyond the {SM}, Renormalization Regularization and Renormalons, Stochastic Processes},
	file = {Full Text PDF:/Users/vpedreros/Zotero/storage/5WIKS88J/Carrasco et al. - 2012 - The effective field theory of cosmological large scale structures.pdf:application/pdf},
}

@article{creminelli_dark_2017,
	title = {Dark Energy after {GW}170817 and {GRB}170817A},
	volume = {119},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.119.251302},
	doi = {10.1103/PhysRevLett.119.251302},
	abstract = {The observation of {GW}170817 and its electromagnetic counterpart implies that gravitational waves travel at the speed of light, with deviations smaller than a few×10−15. We discuss the consequences of this experimental result for models of dark energy and modified gravity characterized by a single scalar degree of freedom. To avoid tuning, the speed of gravitational waves must be unaffected not only for our particular cosmological solution but also for nearby solutions obtained by slightly changing the matter abundance. For this to happen, the coefficients of various operators must satisfy precise relations that we discuss both in the language of the effective field theory of dark energy and in the covariant one, for Horndeski, beyond Horndeski, and degenerate higher-order theories. The simplification is dramatic: of the three functions describing quartic and quintic beyond Horndeski theories, only one remains and reduces to a standard conformal coupling to the Ricci scalar for Horndeski theories. We show that the deduced relations among operators do not introduce further tuning of the models, since they are stable under quantum corrections.},
	pages = {251302},
	number = {25},
	journaltitle = {Physical Review Letters},
	shortjournal = {Phys. Rev. Lett.},
	author = {Creminelli, Paolo and Vernizzi, Filippo},
	urldate = {2024-10-01},
	date = {2017-12-18},
	note = {Publisher: American Physical Society},
	file = {APS Snapshot:/Users/vpedreros/Zotero/storage/4GRBL2E2/PhysRevLett.119.html:text/html;Full Text PDF:/Users/vpedreros/Zotero/storage/WEXA5MD9/Creminelli and Vernizzi - 2017 - Dark Energy after GW170817 and GRB170817A.pdf:application/pdf},
}

